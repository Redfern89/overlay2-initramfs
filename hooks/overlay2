#!/bin/sh
PREREQ=""
prereqs() { echo "$PREREQ"; }
case $1 in prereqs) prereqs; exit 0;; esac

. /usr/share/initramfs-tools/hook-functions

copy_exec /usr/bin/openssl /usr/bin
copy_exec /usr/sbin/cryptsetup /usr/sbin
copy_exec /sbin/blkid /sbin
copy_exec /lib/cryptsetup/askpass /lib/cryptsetup

for mod in overlay loop dm-mod dm-crypt af_alg algif_skcipher algif_hash \
		crypto_user aes_generic aesni-intel xts sha256 sha512 \
		squashfs ext4 f2fs vfat exfat ntfs3 xfs jffs2 \
		nls_cp437 nls_ascii nls_utf8 nls_cp866; do
	manual_add_modules "${mod}"
done